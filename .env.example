PGUSER=
PGPASSWORD=
PA_DATABASE_URL=postgresql://user:password@localhost:5432/dbname

PA_AUTH_TOKEN=
PA_AUTH_ALLOW_PATH=0

# Standalone assistant backend (futile-pa/assistant/) — calls the Anthropic
# API directly, unlike the MCP server above which only exposes tools to
# whatever client already holds its own key.
ANTHROPIC_API_KEY=

# Phase 2 — the Signal bridge (assistant/signal_bridge.py), via a
# signal-cli-rest-api container on localhost:8080. Linked-device mode: both
# values end up being Andre's own number. SIGNAL_ALLOWED_SENDER is the only
# thing standing between "your assistant" and "anyone who finds this Signal
# ID" — treat it with the same care as PA_AUTH_TOKEN, entered here directly
# on the server, never through chat.
SIGNAL_API_BASE=http://127.0.0.1:8080
SIGNAL_OWN_NUMBER=
SIGNAL_ALLOWED_SENDER=
# Hours before the Signal conversation's short-term memory resets. Env var,
# not a code constant, specifically so this can change without a deploy.
SIGNAL_MEMORY_RESET_HOURS=24

# Path to the futile-pa checkout (task/project backend). Stale before
# 2026-10-28: futile-pa moved into this repo as a subdirectory, so the real
# default (server.py and assistant/__init__.py both use it) is the in-repo
# path below, not a separate sibling checkout. Leave unset unless you
# genuinely have futile-pa somewhere else.
FUTILE_PA_PATH=/home/dremon/tools/personal-context-mcp/futile-pa
