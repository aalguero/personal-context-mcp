PGUSER=
PGPASSWORD=
PA_DATABASE_URL=postgresql://user:password@localhost:5432/dbname

PA_AUTH_TOKEN=
PA_AUTH_ALLOW_PATH=0

# Standalone assistant backend (futile-pa/assistant/) — calls the Anthropic
# API directly, unlike the MCP server above which only exposes tools to
# whatever client already holds its own key.
ANTHROPIC_API_KEY=

# Path to the futile-pa checkout (task/project backend). Stale before
# 2026-10-28: futile-pa moved into this repo as a subdirectory, so the real
# default (server.py and assistant/__init__.py both use it) is the in-repo
# path below, not a separate sibling checkout. Leave unset unless you
# genuinely have futile-pa somewhere else.
FUTILE_PA_PATH=/home/dremon/tools/personal-context-mcp/futile-pa
